<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="20dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#FFFFFFFF"
        app:cardCornerRadius="28dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="22dp"
            android:paddingEnd="24dp"
            android:paddingBottom="28dp">

            <ImageView
                android:id="@+id/ivRateUs"
                android:layout_width="200dp"
                android:layout_height="170dp"
                android:contentDescription="@string/rate_us_title"
                android:scaleType="fitCenter"
                android:src="@drawable/icon_rate_us" />

            <TextView
                android:id="@+id/tvRateTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/inter_bold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/rate_us_title"
                android:textColor="#FF111111"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvRateMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:fontFamily="@font/inter_regular"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/rate_us_initial_message"
                android:textColor="#FF151515"
                android:textSize="20sp" />

            <LinearLayout
                android:id="@+id/starsGroup"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnStar1"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/rate_us_star_1"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/icon_star_unselected" />

                <ImageButton
                    android:id="@+id/btnStar2"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/rate_us_star_2"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/icon_star_unselected" />

                <ImageButton
                    android:id="@+id/btnStar3"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/rate_us_star_3"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/icon_star_unselected" />

                <ImageButton
                    android:id="@+id/btnStar4"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/rate_us_star_4"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/icon_star_unselected" />

                <ImageButton
                    android:id="@+id/btnStar5"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/rate_us_star_5"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/icon_star_unselected" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRateAction"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="26dp"
                android:enabled="false"
                android:fontFamily="@font/inter_bold"
                android:text="@string/rate_us_action"
                android:textColor="#FFFFFFFF"
                android:textSize="18sp"
                app:backgroundTint="#FF2F80ED"
                app:cornerRadius="28dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
