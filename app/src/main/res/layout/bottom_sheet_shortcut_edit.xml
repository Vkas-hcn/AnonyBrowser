<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_history_sheet"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="28dp">

    <View
        android:layout_width="41dp"
        android:layout_height="7dp"
        android:background="@drawable/bg_history_sheet_handle" />

    <TextView
        android:id="@+id/tvSheetTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:fontFamily="@font/inter_bold"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="@string/shortcut_add_title"
        android:textColor="@color/mainTextColor"
        android:textSize="16sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/inputName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:paddingVertical="15dp"
        android:background="@drawable/bg_shortcut_input"
        android:fontFamily="@font/inter_regular"
        android:hint="@string/shortcut_name_hint"
        android:includeFontPadding="false"
        android:inputType="textCapWords"
        android:maxLines="1"
        android:paddingHorizontal="28dp"
        android:singleLine="true"
        android:textColor="#111111"
        android:textColorHint="@color/mainTextColor"
        android:textSize="18sp" />

    <EditText
        android:id="@+id/inputUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:paddingVertical="15dp"
        android:background="@drawable/bg_shortcut_input"
        android:fontFamily="@font/inter_regular"
        android:hint="@string/shortcut_url_hint"
        android:includeFontPadding="false"
        android:inputType="textUri"
        android:maxLines="1"
        android:paddingHorizontal="28dp"
        android:singleLine="true"
        android:textColor="#111111"
        android:textColorHint="@color/mainTextColor"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="30dp"
        android:background="@drawable/bg_history_btn_save"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/inter_bold"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="@string/browser_save"
        android:textColor="#FF000000"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnCancel"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_history_btn_cancel"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/inter_regular"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="@string/browser_cancel"
        android:textColor="#FF000000"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
