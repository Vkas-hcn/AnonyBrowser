<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/browserRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/browserToolbar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="8dp">

        <ImageView
            android:id="@+id/ivSecurity"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/browser_security_status"
            android:src="@drawable/ic_security" />

        <LinearLayout
            android:id="@+id/urlBox"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="24dp"
            android:layout_weight="1"
            android:paddingStart="17dp"
            android:background="@drawable/bg_search_page_input"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivLock"
                android:layout_width="10dp"
                android:layout_height="13dp"
                android:contentDescription="@string/browser_secure_connection"
                android:src="@drawable/ic_lock" />

            <EditText
                android:id="@+id/tvUrlHost"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:autofillHints="url"
                android:background="@android:color/transparent"
                android:ellipsize="end"
                android:fontFamily="@font/inter_medium"
                android:gravity="center_vertical"
                android:imeOptions="actionSearch"
                android:includeFontPadding="false"
                android:inputType="textUri"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="#FF111111"
                android:textCursorDrawable="@null"
                android:selectAllOnFocus="true"
                android:textSize="15sp"
                tools:text="https://www.youtube.com" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/btnBrowserTabs"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/browser_tabs"
            android:focusable="true">

            <TextView
                android:id="@+id/tvBrowserTabCount"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_tab_counter"
                android:fontFamily="@font/inter_medium"
                android:gravity="center"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:textColor="#2C323A"
                android:textSize="14sp"
                tools:text="1" />
        </FrameLayout>

        <ImageButton
            android:id="@+id/btnBrowserMenu"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/browser_menu"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_net_menu" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="#E6E9EE" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ProgressBar
            android:id="@+id/loadProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:indeterminate="false"
            android:max="100"
            android:progress="0"
            android:progressTint="#0B80F7"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/errorPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#F5F7FB"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/ivError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/browser_error_unexpected_title"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_error" />

            <TextView
                android:id="@+id/tvErrorTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:fontFamily="@font/inter_medium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textColor="@color/mainTextColor"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="Unexpected error" />

            <TextView
                android:id="@+id/tvErrorMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:fontFamily="@font/inter_regular"
                android:gravity="center"
                android:includeFontPadding="false"
                android:lineSpacingExtra="2dp"
                android:textColor="#82968B"
                android:textSize="14sp"
                tools:text="Something happened! The browser ran into an unexpected condition and can't fulfill the request." />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnErrorPrimary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="44dp"
                android:background="@drawable/bg_allow"
                android:fontFamily="@font/inter_medium"
                android:includeFontPadding="false"
                android:paddingVertical="13dp"
                android:text="@string/browser_reload_page"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="@color/mainTextColor"
                android:textSize="16sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnErrorSecondary"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_deny"
                android:fontFamily="@font/inter_medium"
                android:includeFontPadding="false"
                android:text="@string/browser_continue_anyway"
                android:textAllCaps="false"
                android:textColor="#111111"
                android:textSize="17sp"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
